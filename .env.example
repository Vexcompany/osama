# Supabase configuration
# Get these from your Supabase project: https://app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only service role key (NEVER expose to client)
# Used for inserts that bypass RLS for the public form (we still validate at API layer)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: honeypot field name. Clients never see this; bots usually fill it.
HONEYPOT_FIELD_NAME=website_url

# Optional: rate limit window in seconds (default 60)
RATE_LIMIT_WINDOW_SECONDS=60
# Optional: max submissions per IP per window (default 3)
RATE_LIMIT_MAX=3
